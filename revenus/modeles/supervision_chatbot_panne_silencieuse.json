    {"parameters": {"chatId": "VOTRE_CHAT_ID", "text": "=🚨 Chatbot EN PANNE (silencieuse ?) — code {{ $json.statusCode }} — réponse : {{ JSON.stringify($json.body).slice(0, 300) }}", "additionalFields": {}}, "name": "Alerte Telegram", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [780, 120], "credentials": {"telegramApi": {"id": "", "name": "Bot Telegram"}}},
    {"parameters": {"url": "=http://localhost:8791/battement/chatbot-site?token={{ $env.VEILLEUR_TOKEN }}", "options": {"timeout": 5000}}, "name": "Battement OK", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [780, -120], "continueOnFail": true}
  ],
  "connections": {
    "Toutes les 5 min": {"main": [[{"node": "Poser la question test", "type": "main", "index": 0}]]},
    "Poser la question test": {"main": [[{"node": "Réponse correcte ?", "type": "main", "index": 0}]]},
    "Réponse correcte ?": {"main": [[{"node": "Battement OK", "type": "main", "index": 0}], [{"node": "Alerte Telegram", "type": "main", "index": 0}]]}
