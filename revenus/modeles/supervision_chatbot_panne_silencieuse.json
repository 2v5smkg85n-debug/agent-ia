{
  "name": "Supervision d'un chatbot — détecter les pannes silencieuses",
  "nodes": [
    {"parameters": {"rule": {"interval": [{"field": "minutes", "minutesInterval": 5}]}}, "name": "Toutes les 5 min", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 0]},
    {"parameters": {"method": "POST", "url": "https://VOTRE-SITE.fr/api/chat", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ message: 'Bonjour, quels sont vos horaires ?' }) }}", "options": {"timeout": 15000, "response": {"response": {"fullResponse": true}}}}, "name": "Poser la question test", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [260, 0], "continueOnFail": true},
    {"parameters": {"conditions": {"options": {"caseSensitive": false, "leftValue": "", "typeValidation": "loose"}, "conditions": [
      {"id": "c1", "leftValue": "={{ $json.statusCode }}", "rightValue": 200, "operator": {"type": "number", "operation": "equals"}},
      {"id": "c2", "leftValue": "={{ JSON.stringify($json.body).toLowerCase() }}", "rightValue": "h", "operator": {"type": "string", "operation": "contains"}},
      {"id": "c3", "leftValue": "={{ JSON.stringify($json.body).toLowerCase() }}", "rightValue": "error", "operator": {"type": "string", "operation": "notContains"}}
