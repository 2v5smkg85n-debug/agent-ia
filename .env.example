
# --- Strategies de tendance (07/11/2026) : donchian_breakout / tsmom, droit d'ouvrir via registre_strategies.py droit <s> on
# TENDANCE=1                 # 0 pour couper les deux strategies
# TENDANCE_TP_RATIO=3        # objectif = 3 x stop, puis stop suiveur
# TENDANCE_BARRIERE_H=168    # 7 jours
# DONCHIAN_ENTREE=20 ; DONCHIAN_SORTIE=10 ; DONCHIAN_VOL=1.0 ; TENDANCE_EMA_JOURS=84
# TSMOM_COURT=20 ; TSMOM_LONG=90 ; TSMOM_SMA=200 ; TSMOM_FRAICHEUR=5
# PORTE_ADX_RANGE=1 ; ADX_RANGE_MAX=25   # retour a la moyenne interdit quand ADX 4h > 25 (mesure, desarmable)

# --- Professeur Hyperliquid (10/11/2026) : les meilleurs traders verifies sur chaine, sans cle. Aucun droit d'ouvrir.
# PROF_HYPERLIQUID=1           # 0 pour couper
# HL_N_TRADERS=40              # taille de la cohorte « les meilleurs »
# HL_CAPITAL_MIN=250000        # capital minimum ($) d'un compte suivi
# HL_ROI_MOIS_MIN=0.05 ; HL_ROI_MOIS_MAX=3.0   # rendement du mois accepte (5 % .. 300 %)
# HL_ROTATION_MAX=60           # volume du mois / capital maximum (ecarte teneurs de marche et coffres)
# HL_DETENTION_MIN_H=1         # detention mediane sous 1 h = scalpeur : profile, mais positions non lues
# HL_N_PROFILS=40              # nombre de traders dont on apprend le style (2 000 derniers ordres chacun)
# HL_RAFRAICHIR_COHORTE_H=6 ; HL_RAFRAICHIR_POSITIONS_S=900
